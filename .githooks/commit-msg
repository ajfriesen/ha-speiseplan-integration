#!/usr/bin/env bash
set -euo pipefail

# Conventional Commits are what release-please reads to decide the next version.
case "$(head -1 "$1")" in
    "Merge "*|"Revert "*|"Reapply "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

if ! command -v cz >/dev/null 2>&1; then
    echo "commit-msg hook: cz not found, skipping check" >&2
    exit 0
fi

exec cz check --commit-msg-file "$1"
